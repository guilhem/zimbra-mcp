# Documentation only. Configure real values through the host's secure secret UI.
# Never send passwords in chat or commit a populated credentials file.
MCP_AUTH_MODE=sites
MCP_ALLOWED_USER_ID=
# Alternatively use the verified owner email supplied by Sites. If both are set,
# BOTH must match. These describe the Sites owner, not the Zimbra mailbox.
MCP_ALLOWED_USER_EMAIL=
ZIMBRA_URL=https://your-zimbra.example
ZIMBRA_USER=
ZIMBRA_PASSWORD=

# Writes are disabled unless this is exactly the lowercase string true.
# Enabling production writes expands access and requires separate owner approval.
ZIMBRA_WRITE_ENABLED=false
